extends Node2D
## Soul ball — the player's blank soul.
## Phase 0: moves with WASD/arrows, blasts with SPACE.
##
## The soul is a circle. White or black. The void mirrors it.
## "Each use blasts/farts — since it's still the start of the game,
##  and everything is still just black and white, damn it."

const SacredGeometryScript := preload("res://scripts/sacred_geometry.gd")
const SOUL_UI_BASE := 10.0  # visual-proportion base for this file (canon/01b-sacred-geometry.md); NOT a balance constant

var polarity: int = 0  # 0 = white/creation, 1 = black/destruction
# Typed as the concrete class, not plain RefCounted: GDScript resolves
# `.propname` on a loosely-typed RefCounted variable through a dynamic
# lookup that can fail to find custom script members even though
# `.get("propname")` on the exact same object succeeds (confirmed via
# direct diagnostic — genome.get("skill_template") worked while
# genome.skill_template threw "Invalid access to property or key" on the
# same call). Concrete typing makes the compiler resolve it directly.
var genome: SoulGenome = null
var color_unlocked: bool = false  # true when Pandora's box opens

# Only the soul the player currently inhabits reads WASD/SPACE. Every other
# soul (both armies) is driven entirely by main.gd's _ai_think — set by
# main.gd whenever active_body changes (spawn, incarnation).
var is_active: bool = false

# Concealment (black souls ambushing in dark hex zones) — main.gd computes the
# target each frame from hex terrain + distance to the viewer and eases toward
# it here so it fades rather than snaps.
var concealment_alpha: float = 1.0

# --- Body texture (generated by blender/generate_souls.py) ---
# Loaded, not preloaded: falls back to the procedural circle if the asset
# pipeline hasn't been run (see blender/generate_souls.py + DESIGN.md).
var soul_texture: Texture2D = null

# --- Soul shape ---
var radius: float = 26.0
var time_alive: float = 0.0

# --- Movement ---
var move_speed: float = 120.0
var velocity: Vector2 = Vector2.ZERO
var facing_angle: float = PI  # facing left initially

# --- Blast system ---
var blast_cooldown: float = 0.3
var blast_timer: float = 0.0
var fragments: Array[Dictionary] = []
var total_blasts_fired: int = 0

# --- Life system ---
var damage_flash: float = 0.0  # timer for flash on hit
var death_color: Color = Color.BLACK  # the color that killed us
var killing_source: String = ""  # what killed us

# --- Force field (black soul) ---
var force_field_active: bool = false
var force_field_strength: float = 0.0  # ramps up while SPACE held

# --- Signals ---
signal first_blast


func _apply_polarity() -> void:
	# Called by main.gd after polarity is set
	if genome:
		# Size from STA (stamina = volume)
		radius = 16.0 + genome.STA * 0.15
	var tex_path := "res://assets/white_soul.png" if polarity == 0 else "res://assets/black_soul.png"
	if ResourceLoader.exists(tex_path):
		soul_texture = load(tex_path)
	# Add camera that follows the soul
	var cam := Camera2D.new()
	cam.name = "Camera"
	cam.zoom = Vector2(1.0, 1.0)
	cam.position_smoothing_enabled = true
	cam.position_smoothing_speed = 3.0
	add_child(cam)
	cam.make_current()
	queue_redraw()


func _ready() -> void:
	pass


func _process(delta: float) -> void:
	modulate.a = concealment_alpha
	time_alive += delta
	blast_timer = maxf(0.0, blast_timer - delta)
	damage_flash = maxf(0.0, damage_flash - delta)

	# =====================
	# INPUT (player-controlled soul only — AI souls are moved by main.gd's _ai_think)
	# =====================
	if is_active:
		var input := Vector2.ZERO
		if Input.is_key_pressed(KEY_W) or Input.is_key_pressed(KEY_UP):
			input.y -= 1.0
		if Input.is_key_pressed(KEY_S) or Input.is_key_pressed(KEY_DOWN):
			input.y += 1.0
		if Input.is_key_pressed(KEY_A) or Input.is_key_pressed(KEY_LEFT):
			input.x -= 1.0
		if Input.is_key_pressed(KEY_D) or Input.is_key_pressed(KEY_RIGHT):
			input.x += 1.0

		if input.length_squared() > 0.0:
			input = input.normalized()
			facing_angle = input.angle()

		# Smooth acceleration / deceleration (genome feeds speed)
		var spd := move_speed
		if genome:
			spd = genome.get_speed()
		# Heavy — slow start, high friction
		velocity = velocity.lerp(input * spd, 2.0 * delta)
		velocity *= 0.92  # friction — things stop when you stop
		position += velocity * delta

	# Gentle floating wobble (even when stationary) — slower, applies to everyone.
	# Speeds/amplitude re-derived from PHI (canon/01b-sacred-geometry.md).
	var wobble := Vector2(
		sin(time_alive * SacredGeometryScript.ladder(-1.0)) * SacredGeometryScript.ladder(1.0),  # 0.8->PHI^-1, 1.5->PHI^1
		cos(time_alive * SacredGeometryScript.ladder(-1.5)) * 1.0  # 0.6->PHI^-1.5; 1.0 == PHI^0, exact
	)
	position += wobble * delta

	# Keep in arena bounds (larger than viewport — camera follows)
	var margin := radius + SOUL_UI_BASE * SacredGeometryScript.ladder(-2.0)  # 4.0 -> 3.82
	position.x = clampf(position.x, margin, 2400.0 - margin)
	position.y = clampf(position.y, margin, 1800.0 - margin)

	# =====================
	# ABILITY (player-controlled soul only — AI souls fire/field via _ai_think)
	# =====================
	if is_active:
		if polarity == 0:
			# WHITE: fire beam on press
			if Input.is_key_pressed(KEY_SPACE) and blast_timer <= 0.0:
				_fire_ability()
				blast_timer = blast_cooldown
		else:
			# BLACK: force field while held
			if Input.is_key_pressed(KEY_SPACE):
				force_field_active = true
				force_field_strength = minf(1.0, force_field_strength + delta * 2.5)
			else:
				force_field_active = false
				force_field_strength = maxf(0.0, force_field_strength - delta * 4.0)

	# =====================
	# UPDATE PROJECTILES
	# =====================
	for i in range(fragments.size() - 1, -1, -1):
		var f: Dictionary = fragments[i]
		f["age"] += delta
		if f["age"] >= f["life"]:
			fragments.remove_at(i)

	queue_redraw()


# ===================================================================
# ABILITY — WHITE = light beam, BLACK = force field (repulsion)
# ===================================================================

func _fire_ability() -> void:
	total_blasts_fired += 1
	if total_blasts_fired == 1:
		first_blast.emit()
	if not genome:
		return
	_fire_light_beam()
	blast_cooldown = 0.2


func _fire_light_beam() -> void:
	# White: a beam of light — a line of color, not balls
	# Store in LOCAL coordinates (relative to soul) for _draw()
	var dmg: float = genome.get_laser_damage()
	var rng: float = genome.get_laser_range()
	# The skill template's growth overrides/augments the raw genome formulas,
	# so the laser's growth is a designed curve, not just a raw stat.
	if genome.skill_template:
		var m: Dictionary = genome.skill_template.compute_mechanics()
		dmg = m["damage"]
		rng = m["range"]
		blast_cooldown = m["cooldown"]
	var life_factor := 0.5 + get_life_pct() * 0.5
	dmg *= life_factor
	var dir := Vector2(cos(facing_angle), sin(facing_angle))
	fragments.append({
		"type": "beam",
		"start": dir * (radius + SOUL_UI_BASE * SacredGeometryScript.ladder(-2.0)),  # 4.0 -> 3.82
		"end": dir * rng,
		"damage": dmg,
		"age": 0.0,
		"life": 0.4,  # hit-detection window -- gameplay balance, excluded
		"pierce": genome.skill_template.has_evolution("pierce") if genome.skill_template else false,
		"split": genome.skill_template.has_evolution("split") if genome.skill_template else false,
	})


func get_force_field_range() -> float:
	if not genome:
		return 0.0
	return 50.0 + genome.get_devour_damage() * 20.0 + force_field_strength * 60.0


func get_active_projectiles() -> Array[Dictionary]:
	return fragments


# ===================================================================
# LIFE — as %, max from factors, drain on damage
# ===================================================================

func get_life_pct() -> float:
	if not genome:
		return 1.0
	return clampf(float(genome.capacity_current) / float(genome.capacity_max), 0.0, 1.0)


func take_damage(amount: float, source: String = "unknown") -> void:
	if not genome:
		return
	# Color = defense: more substance = less damage taken
	var defense_factor := 1.0 - (get_life_pct() * 0.4)
	var final_damage := amount * defense_factor
	genome.capacity_current = maxi(0, genome.capacity_current - int(final_damage))
	damage_flash = 0.25
	killing_source = source
	# Set death color based on source
	match source:
		"void_tile":
			death_color = Color(0.3, 0.3, 0.35)
		"enemy":
			death_color = Color(0.8, 0.2, 0.15)
		"curse":
			death_color = Color(0.4, 0.3, 0.7)
		_:
			death_color = Color(0.5, 0.5, 0.5)
	if genome.capacity_current <= 0:
		_die()


func _die() -> void:
	genome.skulls += 1
	genome.capacity_current = genome.capacity_max
	genome.add_story("killed by %s — the color of ending." % killing_source)
	damage_flash = 0.0


# ===================================================================
# DRAW — the soul's visual
# ===================================================================

func _draw() -> void:
	var life_pct := get_life_pct()

	# === DAMAGE FLASH ===
	var flash_mod := 0.0
	if damage_flash > 0.0:
		flash_mod = damage_flash * 3.0

	if polarity == 0:
		_draw_white_soul(life_pct, flash_mod)
	else:
		_draw_black_soul(life_pct, flash_mod)

	# --- LIFE RING ---
	var ring_radius := radius + SOUL_UI_BASE * SacredGeometryScript.ladder(1.5)  # 22.0 -> 20.58
	var ring_bg := Color(0.2, 0.2, 0.2, 0.5)
	var ring_fill: Color
	if life_pct > 0.6:
		ring_fill = Color(0.4, 0.85, 0.4)
	elif life_pct > 0.3:
		ring_fill = Color(0.85, 0.8, 0.3)
	else:
		ring_fill = Color(0.85, 0.25, 0.2)
	draw_arc(Vector2.ZERO, ring_radius, 0.0, TAU, 32, ring_bg, 3.0, false)
	if life_pct > 0.001:
		draw_arc(Vector2.ZERO, ring_radius, -PI / 2.0, -PI / 2.0 + TAU * life_pct, 48, ring_fill, 3.0, false)

	# --- Force field (black only) ---
	if force_field_active and force_field_strength > 0.0:
		var ff_range := get_force_field_range()
		# Ring spacing/fade/width re-derived from PHI (canon/01b-sacred-geometry.md).
		for i in range(3):
			var rr := ff_range * (0.382 + float(i) * 0.236)  # 0.4->PHI^-2, 0.2->PHI^-3
			var ra := force_field_strength * 0.330 * (1.0 - float(i) * 0.236)  # 0.3->PHI^-2.5, 0.25->PHI^-3
			var rc := Color(0.3, 0.2, 0.5, ra)
			draw_arc(Vector2.ZERO, rr, 0.0, TAU, 48, rc, 2.618 - float(i) * 0.618, false)  # 2.5->PHI^2, 0.5->PHI^-1

	# --- Projectiles (light beams) ---
	for f in fragments:
		if f.get("type") == "beam":
			var progress: float = f["age"] / f["life"]
			var alpha: float = 1.0 - progress
			var segments := 8
			var bvec: Vector2 = f["end"] - f["start"]
			var blen: float = bvec.length()
			var bdir: Vector2 = bvec / maxf(blen, 1.0)
			var slen: float = blen / float(segments)
			# The beam's LOOK is tied to the skill's growth + evolutions: higher
			# level = thicker/brighter beam; pierce = hot white core; split =
			# a forked second beam at half range. This is the visible result of
			# the SkillTemplate growth.
			var pierce: bool = f.get("pierce", false)
			var split: bool = f.get("split", false)
			var lvl: int = 0
			var skill := genome.skill_template if genome else null
			if skill:
				lvl = skill.current_level
			var lvl_frac: float = float(lvl) / 3.0
			var base_w_end: float = 3.82 + lvl_frac * 2.0
			var base_w_start: float = 4.0 + lvl_frac * 1.5
			for pass_i in range(2 if split else 1):
				var pass_dir := bdir
				var pass_start: Vector2 = f["start"]
				if split and pass_i == 1:
					# The split beam forks off at half range.
					pass_start = f["start"] + bdir * blen * 0.5
					pass_dir = bdir.rotated(0.35)
					pass_start += pass_dir * 4.0
				for s2 in segments:
					var sstart: Vector2 = pass_start + pass_dir * slen * float(s2)
					var send: Vector2 = pass_start + pass_dir * slen * float(s2 + 1)
					var fade2: float = 1.0 - float(s2) / float(segments)
					var sw: float = lerpf(base_w_end, base_w_start, fade2) * (0.6 if (split and pass_i == 1) else 1.0)
					var seg_col: Color = Color(1.0, 0.9, 0.7, alpha * fade2 * 0.95) if pierce else Color(1.0, 1.0, 1.0, alpha * fade2 * 0.95)
					draw_line(sstart, send, seg_col, maxf(sw, 1.0), false)
				if split and pass_i == 0:
					# The main beam visibly "splits" at the fork point.
					var fork_col := Color(1.0, 0.7, 0.4, alpha * 0.9)
					draw_circle(f["start"] + bdir * blen * 0.5, 3.0 + lvl_frac * 2.0, fork_col)


## The soul filled with its color/soul/lifeforce, expressed as % — a level,
## not a flat tint. Reuses the life ring's %-as-arc convention (start at
## -PI/2, sweep clockwise by TAU * pct) so the visual language is consistent.
func _draw_color_fill(fill_col: Color, fill_pct: float) -> void:
	if fill_pct <= 0.001:
		return
	var points := PackedVector2Array([Vector2.ZERO])
	var segs: int = maxi(2, int(ceil(40.0 * fill_pct)))  # 40.0 == hex_size, already PHI-base-aligned (canon/01b-sacred-geometry.md)
	for s in range(segs + 1):
		var a: float = -PI / 2.0 + TAU * fill_pct * float(s) / float(segs)
		points.append(Vector2(cos(a), sin(a)) * radius)
	draw_colored_polygon(points, fill_col)


func _draw_white_soul(life_pct: float, flash: float) -> void:
	# WHITE = electron. Shell holds no color (see blender/generate_souls.py) —
	# it's shading only. Color lives in the fill below, sized by life_pct.
	var fill_col := Color(0.6, 0.6, 0.63)
	if genome:
		var seep_amt: float = genome.trace * (0.5 if color_unlocked else 0.2)
		fill_col = fill_col.lerp(Color(0.95, 0.65, 0.3), seep_amt)
	if flash > 0.0:
		fill_col = fill_col.lerp(Color.WHITE, flash)

	# Halo glow — light bleeds outward (this is a radiation source).
	# Step 6.0 -> SOUL_UI_BASE*PHI^-1 (canon/01b-sacred-geometry.md);
	# alpha values (0.22/0.06) are below the ladder's useful resolution at
	# this base and are left as art-direction literals.
	var halo_step := SOUL_UI_BASE * SacredGeometryScript.ladder(-1.0)
	for i in range(3):
		var halo_r: float = radius + halo_step + float(i) * halo_step
		var halo_a: float = (0.22 - float(i) * 0.06) * (0.5 + life_pct * 0.5)
		draw_circle(Vector2.ZERO, halo_r, Color(1.0, 0.97, 0.85, halo_a))

	_draw_color_fill(fill_col, life_pct)

	if soul_texture:
		var tex_size := radius * SacredGeometryScript.ladder(1.5)  # 2.15 -> 2.058
		# Shell drawn translucent — shading modulates the fill instead of
		# hiding it under an opaque colored surface.
		draw_texture_rect(soul_texture, Rect2(Vector2(-tex_size, -tex_size) * 0.5, Vector2(tex_size, tex_size)), false, Color(1.0, 1.0, 1.0, 0.55))
	else:
		# Fallback (asset pipeline not run — see blender/generate_souls.py)
		draw_circle(Vector2.ZERO, radius + 2.0, Color(0.12, 0.12, 0.15, 0.4))
	# Facing dot
	var fi := Vector2(cos(facing_angle), sin(facing_angle)) * (radius - 2.0)
	draw_circle(fi, 2.0, Color(0.3, 0.3, 0.35))


func _draw_black_soul(life_pct: float, flash: float) -> void:
	# BLACK = antimatter. Shell holds no color, shading only — same rule as
	# white. Color lives in the fill below, sized by life_pct.
	var fill_col := Color(0.32, 0.32, 0.36)
	if genome:
		var seep_amt: float = genome.trace * (0.4 if color_unlocked else 0.15)
		fill_col = fill_col.lerp(Color(0.5, 0.25, 0.4), seep_amt)
	if flash > 0.0:
		fill_col = fill_col.lerp(Color(0.5, 0.5, 0.55), flash)

	# Void tendrils — jagged dark spikes reaching outward (this is a void
	# source, not a glow). Rotation/wobble speeds and radial offsets
	# re-derived from PHI (canon/01b-sacred-geometry.md); tendril_count (a
	# topology choice) and the wobble amplitude/phase-spread (below the
	# ladder's useful resolution) are left as art-direction literals.
	var tendril_count := 7
	for i in range(tendril_count):
		var ang: float = TAU * float(i) / float(tendril_count) + time_alive * 0.4236  # 0.4 -> TIME_BASE * PHI^3
		var wobble: float = sin(time_alive * 2.283 + float(i) * 1.7) * 3.0  # 2.2 -> PHI^6.5 * TIME_BASE
		var base_pt := Vector2(cos(ang), sin(ang)) * (radius - SOUL_UI_BASE * SacredGeometryScript.ladder(-3.0))  # 2.0 -> 2.36
		var tip_pt := Vector2(cos(ang), sin(ang)) * (radius + SOUL_UI_BASE + wobble)  # 9.0 -> SOUL_UI_BASE*PHI^0 = 10.0
		draw_line(base_pt, tip_pt, Color(0.02, 0.01, 0.04, 0.55), 2.5, false)

	_draw_color_fill(fill_col, life_pct)

	if soul_texture:
		var tex_size := radius * SacredGeometryScript.ladder(1.5)  # 2.15 -> 2.058
		draw_texture_rect(soul_texture, Rect2(Vector2(-tex_size, -tex_size) * 0.5, Vector2(tex_size, tex_size)), false, Color(1.0, 1.0, 1.0, 0.6))
	else:
		# Fallback (asset pipeline not run — see blender/generate_souls.py)
		draw_circle(Vector2.ZERO, radius + 2.0, Color(0.3, 0.3, 0.35, 0.4))
	# Facing dot
	var fi := Vector2(cos(facing_angle), sin(facing_angle)) * (radius - 2.0)
	draw_circle(fi, 2.0, Color(0.5, 0.5, 0.55))
